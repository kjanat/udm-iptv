{
	"$schema": "https://dprint.dev/schemas/v0.json",
	"useTabs": true,
	"json": {},
	"markdown": {
		"emphasisKind": "asterisks",
		"lineWidth": 100,
		"textWrap": "never",
		"codeBlock.useTabs": false,
	},
	"shfmt": {
		"useTabs": true,
		"binaryNextLine": true,
		"switchCaseIndent": true,
		"associations": [
			".github/**/*.*sh",
			"completions/udm-iptv",
			"debian/config",
			"debian/post*",
			"docker/**/*.*sh",
			"udm-iptv",
			"udm-iptv-diag",
			"udm-iptv-diagnostics",
			"udm-iptv-restore",
			"udm-iptvd",
		]
	},
	"ruff": {},
	"yaml": { "printWidth": 160 },
	"plugins": [
		"https://plugins.dprint.dev/kjanat/shfmt-1.1.1.wasm",
		"npm:@dprint/json@0.23.0",
		"npm:@dprint/markdown@0.24.0",
		"npm:@dprint/ruff@0.8.7",
		"npm:dprint-plugin-yaml@0.6.0",
		"npm:dprint-plugin-graphql@0.2.3",
	],
}
