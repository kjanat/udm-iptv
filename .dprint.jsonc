{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "useTabs": true,
  "incremental": true,
  "excludes": ["dist/**", "**/vendor", "docs/rfc/**"],
  "json": {
    "preferSingleLine": false,
    "useTabs": false
  },
  "jsonSchemaSort": {
    "associations": [
      "**/schema.json",
      "**/*.schema.json"
    ]
  },
  "markdown": {
    "emphasisKind": "asterisks",
    "lineWidth": 100,
    "textWrap": "maintain"
  },
  "shfmt": {
    "useTabs": true,
    "binaryNextLine": true,
    "switchCaseIndent": true,
    "associations": [
      "packaging/deb/config",
      "packaging/deb/postinstall",
      "packaging/deb/postremove",
      "packaging/deb/preinstall",
      "packaging/deb/preremove"
    ]
  },
  "yaml": { "printWidth": 160 },
  "exec": {
    "cwd": "${configDir}",
    "commands": [
      {
        "command": "tombi format - --stdin-filename {{file_path}}",
        "exts": ["toml"],
        "setupCommand": "node -e \"try { require('child_process').execSync('tombi --version', {stdio:'ignore'}); } catch { require('child_process').execSync('npm i -g tombi', {stdio:'inherit'}); }\"",
        "cacheKeyFiles": ["tombi.toml"]
      },
      {
        "command": "golangci-lint fmt --stdin",
        "exts": ["go"],
        "cacheKeyFiles": [".golangci.toml"],
      }
    ]
  },
  "plugins": [
    "https://plugins.dprint.dev/kjanat/json-schema-sort-0.1.2.wasm",
    "npm:@dprint/shfmt@0.1.2",
    "npm:@dprint/json@0.25.2",
    "npm:@dprint/markdown@0.28.0",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@jakebailey/dprint-plugin-gofumpt@0.0.19",
    "npm:@dprint/exec@0.7.3/plugin.json@704701df449dd7e942a71144773778ac529d68c2e4657bfc236d393b898b9a67",
    "npm:@dprint/dockerfile@0.7.0",
    "npm:@dprint/ruff@0.11.1",
    "npm:dprint-plugin-graphql@0.2.3",
  ],
}
