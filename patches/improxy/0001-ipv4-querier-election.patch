+++ b/src/querier.c
@@ -0,0 +1,153 @@
+/* SPDX-License-Identifier: LGPL-3.0-or-later */
+#include <string.h>
+#include "querier.h"
+
+int imp_is_querier(const imp_interface *p_if)
+{
+    return p_if->if_addr.ss.ss_family != AF_INET || !p_if->other_querier;
+}
+
+unsigned int imp_query_interval(const imp_interface *p_if)
+{
+    return p_if->if_addr.ss.ss_family == AF_INET && p_if->query_interval ?
+        p_if->query_interval : TIMER_QI;
+}
+
+unsigned int imp_query_response(const imp_interface *p_if)
+{
+    return p_if->if_addr.ss.ss_family == AF_INET && p_if->robustness ?
+        p_if->query_response : TIMER_QRI * 10;
+}
+
+unsigned int imp_robustness(const imp_interface *p_if)
+{
+    return p_if->if_addr.ss.ss_family == AF_INET && p_if->robustness ?
+        p_if->robustness : DEFAULT_RV;
+}
+
+unsigned int imp_membership_interval(const imp_interface *p_if)
+{
+    /* This implementation follows RFC 3376's membership timer model. */
+    return imp_robustness(p_if) * imp_query_interval(p_if) +
+        (imp_query_response(p_if) + 9) / 10;
+}
+
+unsigned int imp_last_member_time(const imp_interface *p_if)
+{
+    return imp_robustness(p_if) * TIMER_LMQI;
+}
+
+static unsigned int decode_query_code(unsigned char code)
+{
+    if (code < 128)
+        return code;
+    return ((code & 15) | 16) << (((code >> 4) & 7) + 3);
+}
+
+unsigned char imp_encode_query_code(unsigned int value)
+{
+    unsigned int code;
+    for (code = 0; code < 255; code++) {
+        if (decode_query_code(code) >= value)
+            return code;
+    }
+    return 255;
+}
+
+/* Timer deadlines retain the half-decisecond precision of OQPI. */
+static void deadline(struct timeval *result, unsigned int half_deciseconds)
+{
+    imp_time_val(half_deciseconds / 20, result);
+    result->tv_usec += (half_deciseconds % 20) * 50000;
+    if (result->tv_usec >= 1000000) {
+        result->tv_sec++;
+        result->tv_usec -= 1000000;
+    }
+}
+
+static void lower_timer(imp_timer *timer, const struct timeval *limit)
+{
+    if (timer != NULL && TIMEVAL_LT(*limit, timer->tm))
+        timer->tm = *limit;
+}
+
+void imp_input_query(imp_interface *p_if, in_addr_t source,
+                     const unsigned char *query, size_t length)
+{
+    in_addr_t group;
+    unsigned int count = 0, response, robustness = DEFAULT_RV;
+    unsigned int interval = TIMER_QI;
+    int suppress = 0;
+    pi_addr address;
+    imp_group *p_gp;
+    struct timeval limit;
+    unsigned int i;
+
+    if (p_if->if_addr.ss.ss_family != AF_INET ||
+        p_if->type != INTERFACE_DOWNSTREAM || length < 8 || query[0] != 0x11)
+        return;
+    memcpy(&group, query + 4, sizeof(group));
+    if (length == 8) {
+        response = query[1] ? query[1] : TIMER_QRI * 10;
+    } else {
+        if (length < 12)
+            return;
+        count = ((unsigned int)query[10] << 8) | query[11];
+        if (count > (length - 12) / 4)
+            return;
+        response = decode_query_code(query[1]);
+        robustness = query[8] & 7;
+        if (!robustness)
+            robustness = DEFAULT_RV;
+        interval = decode_query_code(query[9]);
+        if (!interval)
+            interval = TIMER_QI;
+        suppress = query[8] & 8;
+    }
+    if ((group == INADDR_ANY && count != 0) ||
+        (group != INADDR_ANY && !IN_MULTICAST(ntohl(group))))
+        return;
+    /* RFC 9776 elects on General Queries. RFC 2236's v2 state machine
+     * elects on Membership Queries, including Group-Specific Queries. */
+    if ((group == INADDR_ANY || get_im_version(AF_INET) == IM_IGMPv2_MLDv1) &&
+        source != INADDR_ANY &&
+        ntohl(source) < ntohl(p_if->if_addr.v4.sin_addr.s_addr)) {
+        /* A snooping switch's 0.0.0.0 query is not an election candidate
+         * (RFC 4541). Never change MFC forwarding here: the configured
+         * topology has one forwarding proxy, permitted by RFC 4605. */
+        p_if->other_querier = 1;
+        if (group == INADDR_ANY) {
+            p_if->robustness = robustness;
+            p_if->query_interval = interval;
+            p_if->query_response = response;
+        }
+        if (p_if->gq_timer != NULL)
+            deadline(&p_if->gq_timer->tm,
+                     imp_robustness(p_if) * imp_query_interval(p_if) * 20 +
+                     imp_query_response(p_if));
+        IMP_LOG_INFO("Lower-address querier on %s; suspend general queries\n",
+                     p_if->if_name);
+    }
+    if (group == INADDR_ANY || suppress)
+        return;
+    /* RFC 2236 non-queriers and RFC 3376 routers synchronize existing
+     * membership timers with queries. A query never creates membership. */
+    imp_build_piaddr(AF_INET, &group, &address);
+    p_gp = imp_group_find(p_if, &address);
+    if (p_gp == NULL)
+        return;
+    deadline(&limit, imp_robustness(p_if) * response * 2);
+    if (count == 0) {
+        lower_timer(p_gp->timer, &limit);
+        return;
+    }
+    for (i = 0; i < count; i++) {
+        in_addr_t source_addr;
+        imp_source *p_source;
+        memcpy(&source_addr, query + 12 + i * 4, sizeof(source_addr));
+        imp_build_piaddr(AF_INET, &source_addr, &address);
+        p_source = imp_source_find(p_gp, &address, FORWARDING);
+        if (p_source != NULL)
+            lower_timer(p_source->timer, &limit);
+    }
+}
