# the Free Software Foundation; either version 2 of the License, or
# (at your option) any later version.

set -eu

UDM_IPTV_STATE_DIR="${UDM_IPTV_STATE_DIR:-/data/udm-iptv}"
UDM_IPTV_REPOSITORY="${UDM_IPTV_REPOSITORY:-fabianishere/udm-iptv}"
UDM_IPTV_BRANCH="${UDM_IPTV_BRANCH:-HEAD}"
UDM_IPTV_LOCK_TIMEOUT="${UDM_IPTV_LOCK_TIMEOUT:-1800}"

dest=

cleanup() {
	if [ -n "${dest}" ]; then
		rm -rf "${dest}"
	fi
}

if systemctl is-active --quiet udm-iptv 2>/dev/null; then
	echo "udm-iptv is already running, nothing to restore."
	exit 0
fi

if ! [ -e "${UDM_IPTV_STATE_DIR}/debconf.preseed" ]; then
	echo "error: No saved configuration found in ${UDM_IPTV_STATE_DIR}."
	echo "Run the following command while udm-iptv is installed:"
	echo
	printf "\t udm-iptv persist\n"
	exit 1
fi

# UniFi OS reinstalls its own packages on the first boot after a firmware update
# and holds the dpkg lock for as long as that takes.
waited=0
while fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1; do
	if [ "${waited}" -ge "${UDM_IPTV_LOCK_TIMEOUT}" ]; then
		echo "error: Another package manager still holds the lock after ${waited}s."
		exit 1
	fi

	if [ "${waited}" -eq 0 ]; then
		echo "Waiting for another package manager to finish..."
	fi

	sleep 15
	waited=$((waited + 15))
done

export DEBIAN_FRONTEND=noninteractive

if [ -e "${UDM_IPTV_STATE_DIR}/udm-iptv.deb" ]; then
	trap cleanup EXIT
	dest=$(mktemp -d)

	cp "${UDM_IPTV_STATE_DIR}/udm-iptv.deb" "${dest}/udm-iptv.deb"
	chown _apt:root "${dest}/udm-iptv.deb"

	echo "Installing the package saved in ${UDM_IPTV_STATE_DIR}..."
	apt-get update >/dev/null 2>&1 || true
	apt-get install -o Acquire::AllowUnsizedPackages=1 -q -y "${dest}/udm-iptv.deb"
else
	echo "No package saved in ${UDM_IPTV_STATE_DIR}, running the installer..."
	installer=$(curl -fsSL "https://raw.githubusercontent.com/${UDM_IPTV_REPOSITORY}/${UDM_IPTV_BRANCH}/install.sh")
	sh -c "${installer}"
fi

systemctl enable udm-iptv
systemctl restart udm-iptv

state=$(systemctl is-active udm-iptv || true)
echo "Restored udm-iptv, the service is ${state}."
