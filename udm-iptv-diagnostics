#!/bin/sh
# Collect privacy-conscious diagnostics for udm-iptv.

set -eu

DIAGNOSTICS_SCHEMA="io.github.udm-iptv.diagnostics.v1"
DIAGNOSTICS_DIR="${UDM_IPTV_DIAGNOSTICS_DIR:-/tmp}"
CONFIG_FILE="${UDM_IPTV_CONFIG_FILE:-/etc/udm-iptv.conf}"
PROC_DIR="${UDM_IPTV_PROC_DIR:-/proc}"
PROXY_CONFIG_FILE="${UDM_IPTV_PROXY_CONFIG_FILE:-/var/run/igmpproxy.iptv.conf}"
MONOTONIC_FILE="${UDM_IPTV_MONOTONIC_FILE:-/proc/uptime}"
DIAGNOSTICS_ERROR_REPORTED=false
DIAGNOSTICS_STREAM_FORMAT=json

diagnostics_exit() {
	status=$?
	if [ "${status}" -ne 0 ] && [ "${DIAGNOSTICS_ERROR_REPORTED}" != true ]; then
		echo "error: Diagnostics failed unexpectedly (exit status ${status})." >&2
	fi
}
trap 'diagnostics_exit' EXIT

diagnostics_usage() {
	cat <<'EOF'
Usage: udm-iptv diagnose [OPTIONS...]
Collect share-ready diagnostics for troubleshooting.
Options:
  --capture DURATION      Capture changing state in the background (maximum 24h)
  --format FORMAT         Output format: text, json, or both
  --verbosity LEVEL       Detail level: summary, normal, or debug
  -h, --help              Show this message and exit

Durations use s, m, or h, for example 30s, 15m, or 2h. A capture defaults to
both JSON Lines and plain text. A one-time diagnosis defaults to plain text.
EOF
}

diagnostics_error() {
	DIAGNOSTICS_ERROR_REPORTED=true
	echo "error: $*" >&2
}

diagnostics_requirements() {
	if ! command -v jq >/dev/null 2>&1; then
		diagnostics_error "jq is required to produce structured diagnostics."
		return 1
	fi
	if ! [ -r "${CONFIG_FILE}" ]; then
		diagnostics_error "The configuration for udm-iptv is not found."
		echo "Please reconfigure your udm-iptv installation:" >&2
		echo "    udm-iptv reconfigure" >&2
		return 1
	fi
}

diagnostics_load_configuration() {
	# shellcheck source=udm-iptv.conf
	. "${CONFIG_FILE}"

	if [ "${IPTV_WAN_VLAN}" -ne 0 ]; then
		DIAGNOSTICS_TARGET="${IPTV_WAN_VLAN_INTERFACE}"
	else
		DIAGNOSTICS_TARGET="${IPTV_WAN_INTERFACE}"
	fi

	DIAGNOSTICS_DEVICE_ADDRESSES=
	diagnostics_refresh_device_addresses
	DIAGNOSTICS_HOSTNAME=$(hostname 2>/dev/null) || DIAGNOSTICS_HOSTNAME=
}

diagnostics_refresh_device_addresses() {
	discovered_addresses=$(
		{
			ip -o -4 addr show dev "${DIAGNOSTICS_TARGET}" 2>/dev/null \
				| awk '{ split($4, address, "/"); print address[1] }'
			ip -4 route get 1.1.1.1 2>/dev/null \
				| awk '{ for (i = 1; i <= NF; i++) if ($i == "src") { print $(i + 1); exit } }'
			printf '%s\n' "${IPTV_WAN_STATIC_IP:-}" | awk -F/ 'NF && $1 != "" { print $1 }'
		} | awk 'NF && !seen[$0]++'
	)
	DIAGNOSTICS_DEVICE_ADDRESSES=$(
		printf '%s\n%s\n' "${DIAGNOSTICS_DEVICE_ADDRESSES:-}" "${discovered_addresses}" \
			| awk 'NF && !seen[$0]++'
	)
}

diagnostics_sanitize() {
	jq -Rr \
		--arg addresses "${DIAGNOSTICS_DEVICE_ADDRESSES:-}" \
		--arg hostname "${DIAGNOSTICS_HOSTNAME:-}" '
        def regex_escape:
            gsub("(?<special>[][(){}.*+?$^|\\-])"; "\\" + .special);
		def ipv4_octet:
			"(?:25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})";
		def ipv4_address:
			ipv4_octet + "(?:\\." + ipv4_octet + "){3}";
		def ipv6_address:
			"(?i)(?<![0-9a-f:.])(?:" +
			"(?:[0-9a-f]{1,4}:){7}[0-9a-f]{1,4}|" +
			"(?:[0-9a-f]{1,4}:){1,7}:|" +
			"(?:[0-9a-f]{1,4}:){1,6}:[0-9a-f]{1,4}|" +
			"(?:[0-9a-f]{1,4}:){1,5}(?::[0-9a-f]{1,4}){1,2}|" +
			"(?:[0-9a-f]{1,4}:){1,4}(?::[0-9a-f]{1,4}){1,3}|" +
			"(?:[0-9a-f]{1,4}:){1,3}(?::[0-9a-f]{1,4}){1,4}|" +
			"(?:[0-9a-f]{1,4}:){1,2}(?::[0-9a-f]{1,4}){1,5}|" +
			"[0-9a-f]{1,4}:(?:(?::[0-9a-f]{1,4}){1,6})|" +
			":(?:(?::[0-9a-f]{1,4}){1,7}|:)|" +
			"(?:[0-9a-f]{1,4}:){6}" + ipv4_address + "|" +
			"::(?:ffff(?::0{1,4})?:)?" + ipv4_address + "|" +
			"(?:[0-9a-f]{1,4}:){1,4}:" + ipv4_address +
			")(?:%[0-9a-z_.-]+)?(?![0-9a-f:.])";
        def redact_address($address):
            if $address == "" then .
            else gsub(
                "(?<![0-9A-Za-z_.-])" + ($address | regex_escape) + "(?![0-9A-Za-z_.-])";
                "<device-address>"
            )
            end;
        def redact_hostname($value):
            if $value == "" then .
            else gsub(
                "(?i)(?<![0-9A-Za-z_-])" + ($value | regex_escape) + "(?![0-9A-Za-z_-])";
                "<router-hostname>"
            )
            end;
        reduce ($addresses | split("\n")[]) as $address
            (. ; redact_address($address))
        | redact_hostname($hostname)
		| gsub("(?i)(?<![0-9a-f])(?:[0-9a-f]{2}[:-]){5}[0-9a-f]{2}(?![0-9a-f])"; "<mac>")
		| gsub("(?i)(?<![0-9a-f])(?:[0-9a-f]{4}\\.){2}[0-9a-f]{4}(?![0-9a-f])"; "<mac>")
        | gsub("\\b10\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\b"; "<private-ip>")
        | gsub("\\b192\\.168\\.[0-9]{1,3}\\.[0-9]{1,3}\\b"; "<private-ip>")
        | gsub("\\b172\\.(1[6-9]|2[0-9]|3[01])\\.[0-9]{1,3}\\.[0-9]{1,3}\\b"; "<private-ip>")
        | gsub("\\b169\\.254\\.[0-9]{1,3}\\.[0-9]{1,3}\\b"; "<link-local-ip>")
        | gsub("\\b(22[4-9]|23[0-9])\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\b"; "<multicast-group>")
        | gsub("(?i)lease of [0-9]{1,3}(\\.[0-9]{1,3}){3}"; "lease of <device-address>")
        | gsub("(?i)select for [0-9]{1,3}(\\.[0-9]{1,3}){3}"; "select for <device-address>")
        | gsub("(?i)bound to [0-9]{1,3}(\\.[0-9]{1,3}){3}"; "bound to <device-address>")
		| gsub(ipv6_address; "<ipv6-address>")
    '
}

diagnostics_emit() {
	kind=$1
	section=$2
	name=$3
	timestamp=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
	event=$(jq -Rsc \
		--arg schema "${DIAGNOSTICS_SCHEMA}" \
		--arg timestamp "${timestamp}" \
		--arg kind "${kind}" \
		--arg section "${section}" \
		--arg name "${name}" \
		'{schema: $schema, timestamp: $timestamp, kind: $kind, section: $section, name: $name, value: rtrimstr("\n")}')
	case "${DIAGNOSTICS_STREAM_FORMAT}" in
		text) printf '%s\n' "${event}" | diagnostics_render ;;
		json) printf '%s\n' "${event}" ;;
		*)
			diagnostics_error "Invalid diagnostics stream format ${DIAGNOSTICS_STREAM_FORMAT}."
			return 2
			;;
	esac
}

diagnostics_notice() {
	printf '%s\n' "$1" | diagnostics_emit notice "" ""
}

diagnostics_capture_event() {
	name=$1
	message=$2
	timestamp=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
	jq -cn \
		--arg schema "${DIAGNOSTICS_SCHEMA}" \
		--arg timestamp "${timestamp}" \
		--arg name "${name}" \
		--arg message "${message}" \
		--arg verbosity "${verbosity}" \
		--arg format "${format}" \
		--argjson duration_seconds "${seconds}" \
		'{schema: $schema, timestamp: $timestamp, kind: "capture", name: $name, message: $message, duration_seconds: $duration_seconds, verbosity: $verbosity, format: $format}'
}

diagnostics_section() {
	diagnostics_emit section "$1" "" </dev/null
}

diagnostics_value() {
	value=$(printf '%s\n' "$3" | diagnostics_sanitize)
	printf '%s\n' "${value}" | diagnostics_emit value "$1" "$2"
}

diagnostics_block() {
	value=$(printf '%s\n' "$3" | diagnostics_sanitize)
	printf '%s\n' "${value}" | diagnostics_emit block "$1" "$2"
}

diagnostics_render() {
	jq -r '
        if .kind == "notice" then .value
        elif .kind == "section" then "=== \(.section) ==="
        elif .kind == "value" then "\(.name): \(.value)"
        elif .kind == "block" then
            (if .name == "" then empty else "--- \(.name) ---" end), .value
        elif .kind == "sample" then
            "[\(.timestamp)] service=\(.service.active)/\(.service.substate) proxy=\(.service.process) restarts=\(.service.restarts) routes=\(.network.routes) iptv-default=\(.network.default_route) nat-packets=\(.network.nat_packets) multicast-routes=\(.network.multicast_routes) multicast-packets=\(.network.multicast_packets)"
		elif .kind == "capture" then "Capture \(.name): \(.message)"
        else empty
        end
	    '
}

diagnostics_command() {
	output=$("$@" 2>&1) || true
	printf '%s\n' "${output}"
}

diagnostics_firmware() {
	if command -v ubnt-device-info >/dev/null 2>&1; then
		firmware=$(ubnt-device-info firmware 2>/dev/null) || firmware=
		if [ -n "${firmware}" ]; then
			printf '%s\n' "${firmware}"
			return
		fi
	fi
	for version_file in /usr/lib/version /etc/version; do
		if [ -r "${version_file}" ]; then
			head -n 1 "${version_file}"
			return
		fi
	done
	echo unknown
}

diagnostics_model() {
	if command -v ubnt-device-info >/dev/null 2>&1; then
		model=$(ubnt-device-info model 2>/dev/null) || model=
		if [ -n "${model}" ]; then
			printf '%s\n' "${model}"
			return
		fi
	fi
	echo unknown
}

diagnostics_main_process() {
	main_pid=$1
	if [ -z "${main_pid}" ] || [ "${main_pid}" -le 0 ] 2>/dev/null \
		|| ! [ -r "${PROC_DIR}/${main_pid}/cmdline" ]; then
		echo unknown
		return
	fi
	process_arguments=$(tr '\000' '\n' <"${PROC_DIR}/${main_pid}/cmdline")
	while IFS= read -r process_argument; do
		case "${process_argument}" in
			improxy | */improxy)
				echo improxy
				return
				;;
			igmpproxy | */igmpproxy)
				echo igmpproxy
				return
				;;
			*) ;;
		esac
	done <<EOF
${process_arguments}
EOF
	echo unknown
}

diagnostics_proxy_config() {
	if ! [ -r "${PROXY_CONFIG_FILE}" ]; then
		echo unavailable
		return
	fi
	awk '
        /^[[:space:]]*(#|$)/ { next }
        {
            sub(/[[:space:]]*#.*/, "")
            print
        }
    ' "${PROXY_CONFIG_FILE}"
}

diagnostics_nat_rules() {
	iptables -t nat -nvxL POSTROUTING --line-numbers 2>&1 \
		| awk -v target="${DIAGNOSTICS_TARGET}" '
            NR <= 2 || $8 == target
        '
}

diagnostics_link_state() {
	ip -o link show dev "${DIAGNOSTICS_TARGET}" 2>&1 \
		| awk '
            {
                interface = $2
                flags = $3
                mtu = "unknown"
                state = "unknown"
                for (i = 1; i <= NF; i++) {
                    if ($i == "mtu") mtu = $(i + 1)
                    if ($i == "state") state = $(i + 1)
                }
                printf "interface=%s flags=%s mtu=%s state=%s\n", interface, flags, mtu, state
            }
        '
}

diagnostics_address_summary() {
	ip -o -4 addr show dev "${DIAGNOSTICS_TARGET}" 2>/dev/null \
		| awk '
            {
                split($4, address, "/")
                prefixes = prefixes (prefixes == "" ? "" : ",") address[2]
                count++
            }
            END {
                printf "assigned=%d prefix-lengths=%s\n", count + 0, prefixes == "" ? "none" : prefixes
            }
        '
}

diagnostics_routes() {
	ip -4 route show dev "${DIAGNOSTICS_TARGET}" 2>&1 \
		| awk '
            {
                for (i = 1; i <= NF; i++) {
                    if ($i == "via" && i < NF) $(i + 1) = "<gateway>"
                    if ($i == "src" && i < NF) $(i + 1) = "<device-address>"
                }
                print
            }
        '
}

diagnostics_privacy_header() {
	diagnostics_notice "Share-ready udm-iptv diagnostics. Review the output before posting it publicly."
	diagnostics_notice "Privacy: device-assigned, private, link-local, IPv6 and multicast-group addresses and MAC addresses are redacted. Packet payloads, hostnames, serial numbers and credentials are never collected. Public provider source addresses and route prefixes remain visible because they are needed to diagnose IPTV routing."
}

diagnostics_snapshot() {
	verbosity=$1
	include_logs=$2
	diagnostics_refresh_device_addresses

	diagnostics_section "Package and System"
	package=$(dpkg-query -W -f='${binary:Package} ${Version} (${db:Status-Status})' udm-iptv 2>/dev/null) \
		|| package=unavailable
	diagnostics_value "Package and System" Package "${package}"
	model=$(diagnostics_model)
	firmware=$(diagnostics_firmware)
	kernel=$(uname -srvm)
	system_state=$(systemctl is-system-running 2>&1) || true
	diagnostics_value "Package and System" Model "${model}"
	diagnostics_value "Package and System" Firmware "${firmware}"
	diagnostics_value "Package and System" Kernel "${kernel}"
	diagnostics_value "Package and System" "System state" "${system_state}"

	dhcp=${IPTV_WAN_DHCP:-true}
	mac_configured=no
	[ -z "${IPTV_WAN_VLAN_MAC:-}" ] || mac_configured=yes
	dhcp_options_configured=no
	[ -z "${IPTV_WAN_DHCP_OPTIONS:-}" ] || dhcp_options_configured=yes
	static_ip_configured=no
	[ -z "${IPTV_WAN_STATIC_IP:-}" ] || static_ip_configured=yes

	diagnostics_section "Configuration"
	diagnostics_value Configuration "WAN interface" "${IPTV_WAN_INTERFACE}"
	diagnostics_value Configuration "WAN VLAN" "${IPTV_WAN_VLAN}"
	diagnostics_value Configuration "IPTV interface" "${DIAGNOSTICS_TARGET}"
	diagnostics_value Configuration "Custom VLAN MAC configured" "${mac_configured}"
	diagnostics_value Configuration "WAN DHCP" "${dhcp}"
	diagnostics_value Configuration "WAN DHCP options configured" "${dhcp_options_configured}"
	diagnostics_value Configuration "WAN static address configured" "${static_ip_configured}"
	diagnostics_value Configuration "WAN ranges" "${IPTV_WAN_RANGES}"
	diagnostics_value Configuration "LAN interfaces" "${IPTV_LAN_INTERFACES}"
	diagnostics_value Configuration "Proxy configured" "${IPTV_IGMPPROXY_PROGRAM:-unknown}"
	diagnostics_value Configuration "IGMP version" "${IPTV_IGMPPROXY_IGMP_VERSION:-default}"
	diagnostics_value Configuration "Quickleave disabled" "${IPTV_IGMPPROXY_DISABLE_QUICKLEAVE}"
	diagnostics_value Configuration "Proxy debug" "${IPTV_IGMPPROXY_DEBUG}"

	main_pid=$(systemctl show udm-iptv.service --property MainPID --value 2>/dev/null) \
		|| main_pid=0
	unit_enabled=$(systemctl is-enabled udm-iptv.service 2>&1) || true
	unit_active=$(systemctl is-active udm-iptv.service 2>&1) || true
	proxy_process=$(diagnostics_main_process "${main_pid}")
	restarts=$(systemctl show udm-iptv.service --property NRestarts --value 2>/dev/null) \
		|| restarts=unknown
	diagnostics_section "Service State"
	diagnostics_value "Service State" "Unit enabled" "${unit_enabled}"
	diagnostics_value "Service State" "Unit active" "${unit_active}"
	diagnostics_value "Service State" "Proxy process" "${proxy_process}"
	diagnostics_value "Service State" Restarts "${restarts}"

	if [ "${verbosity}" = summary ]; then
		return 0
	fi

	diagnostics_section "IP Link and Route"
	if ip -4 route show dev "${DIAGNOSTICS_TARGET}" 2>/dev/null | grep -q '^default '; then
		default_route=present
	else
		default_route=absent
	fi
	link_state=$(diagnostics_link_state)
	address_summary=$(diagnostics_address_summary)
	ipv4_routes=$(diagnostics_routes)
	diagnostics_value "IP Link and Route" "IPTV default route" "${default_route}"
	diagnostics_block "IP Link and Route" "link state" "${link_state}"
	diagnostics_block "IP Link and Route" "IPv4 address summary" "${address_summary}"
	diagnostics_block "IP Link and Route" "ip -4 route" "${ipv4_routes}"

	diagnostics_section "NAT Rules"
	nat_rules=$(diagnostics_nat_rules)
	diagnostics_block "NAT Rules" "POSTROUTING rules for ${DIAGNOSTICS_TARGET}" "${nat_rules}"

	diagnostics_section "Multicast Routes"
	multicast_routes=$(diagnostics_command ip -s mroute show)
	diagnostics_block "Multicast Routes" "ip -s mroute" "${multicast_routes}"

	diagnostics_section "Service Details"
	service_details=$(diagnostics_command systemctl show --no-pager \
		-p Id -p LoadState -p UnitFileState -p ActiveState -p SubState \
		-p Result -p Job -p MainPID -p ExecMainStatus -p NRestarts \
		udm-iptv.service udm-iptv-restore.service network.target network-online.target)
	diagnostics_block "Service Details" "systemctl show" "${service_details}"

	if [ "${verbosity}" = debug ]; then
		diagnostics_section "Generated Proxy Configuration"
		proxy_config=$(diagnostics_proxy_config)
		diagnostics_block "Generated Proxy Configuration" "igmpproxy.iptv.conf" "${proxy_config}"
	fi

	if [ "${include_logs}" != true ]; then
		return 0
	fi
	if [ "${verbosity}" = debug ]; then
		log_lines=300
	else
		log_lines=100
	fi
	diagnostics_section "Service Logs (current boot)"
	service_logs=$(diagnostics_command journalctl -b -n "${log_lines}" -o cat \
		-u udm-iptv-restore.service -u udm-iptv.service --no-pager)
	diagnostics_block "Service Logs (current boot)" "last ${log_lines} unit messages" "${service_logs}"
}

diagnostics_emit_sample() {
	diagnostics_refresh_device_addresses
	active=$(systemctl is-active udm-iptv.service 2>/dev/null) || active=unknown
	properties=$(systemctl show udm-iptv.service \
		--property SubState --property MainPID --property NRestarts 2>/dev/null) || properties=
	substate=$(printf '%s\n' "${properties}" | sed -n 's/^SubState=//p')
	main_pid=$(printf '%s\n' "${properties}" | sed -n 's/^MainPID=//p')
	restarts=$(printf '%s\n' "${properties}" | sed -n 's/^NRestarts=//p')
	process=$(diagnostics_main_process "${main_pid:-0}")
	routes=$(ip -4 route show dev "${DIAGNOSTICS_TARGET}" 2>/dev/null | awk 'END { print NR + 0 }')
	if ip -4 route show dev "${DIAGNOSTICS_TARGET}" 2>/dev/null | grep -q '^default '; then
		default_route=present
	else
		default_route=absent
	fi
	nat_packets=$(diagnostics_nat_rules | awk -v target="${DIAGNOSTICS_TARGET}" '$8 == target { total += $2 } END { print total + 0 }')
	mroute=$(ip -s mroute show 2>/dev/null) || mroute=
	multicast_routes=$(printf '%s\n' "${mroute}" | awk '/^\(/ && /State: resolved/ { count++ } END { print count + 0 }')
	multicast_packets=$(printf '%s\n' "${mroute}" | awk '/^[[:space:]]*[0-9]+ packets,/ { total += $1 } END { print total + 0 }')
	timestamp=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
	jq -cn \
		--arg schema "${DIAGNOSTICS_SCHEMA}" \
		--arg timestamp "${timestamp}" \
		--arg active "${active}" \
		--arg substate "${substate:-unknown}" \
		--arg process "${process}" \
		--arg restarts "${restarts:-unknown}" \
		--argjson routes "${routes}" \
		--arg default_route "${default_route}" \
		--argjson nat_packets "${nat_packets}" \
		--argjson multicast_routes "${multicast_routes}" \
		--argjson multicast_packets "${multicast_packets}" \
		'{schema: $schema, timestamp: $timestamp, kind: "sample", service: {active: $active, substate: $substate, process: $process, restarts: $restarts}, network: {routes: $routes, default_route: $default_route, nat_packets: $nat_packets, multicast_routes: $multicast_routes, multicast_packets: $multicast_packets}}'
}

diagnostics_parse_duration() {
	duration=$1
	case "${duration}" in
		*[!0-9smh]* | "" | [smh]) return 1 ;;
		*[smh])
			unit=${duration#"${duration%?}"}
			amount=${duration%?}
			;;
		*) return 1 ;;
	esac
	case "${amount}" in
		"" | *[!0-9]*) return 1 ;;
		??????*) return 1 ;;
		*) ;;
	esac
	amount=$(printf '%s\n' "${amount}" | sed 's/^0*//')
	[ -n "${amount}" ] || amount=0
	case "${unit}" in
		s) multiplier=1 ;;
		m) multiplier=60 ;;
		h) multiplier=3600 ;;
		*) return 1 ;;
	esac
	seconds=$((amount * multiplier))
	[ "${seconds}" -gt 0 ] && [ "${seconds}" -le 86400 ] || return 1
	printf '%s\n' "${seconds}"
}

diagnostics_monotonic_seconds() {
	awk '
		NR == 1 {
			split($1, uptime, ".")
			if (uptime[1] !~ /^[0-9]+$/) exit 1
			print uptime[1]
			exit
		}
	' "${MONOTONIC_FILE}" 2>/dev/null || true
}

diagnostics_worker() {
	seconds=$1
	verbosity=$2
	format=$3
	json_output=$4
	text_output=$5
	journal_cursor=$6
	ready_output=$7
	case "${seconds}" in
		"" | *[!0-9]*)
			diagnostics_error "Invalid worker duration ${seconds}."
			return 2
			;;
		*) ;;
	esac
	[ "${seconds}" -gt 0 ] && [ "${seconds}" -le 86400 ] || {
		diagnostics_error "Invalid worker duration ${seconds}."
		return 2
	}
	case "${format}" in
		text | json | both) ;;
		*)
			diagnostics_error "Invalid worker format ${format}."
			return 2
			;;
	esac

	case "${json_output}" in
		"${DIAGNOSTICS_DIR}"/udm-iptv-diagnostics-*.jsonl) ;;
		*)
			diagnostics_error "Refusing unsafe diagnostics output path ${json_output}."
			return 2
			;;
	esac
	case "${text_output}" in
		- | "${DIAGNOSTICS_DIR}"/udm-iptv-diagnostics-*.txt) ;;
		*)
			diagnostics_error "Refusing unsafe diagnostics output path ${text_output}."
			return 2
			;;
	esac
	case "${ready_output}" in
		"${DIAGNOSTICS_DIR}"/udm-iptv-diagnostics-*.ready) ;;
		*)
			diagnostics_error "Refusing unsafe diagnostics readiness path ${ready_output}."
			return 2
			;;
	esac
	current_uid=$(id -u)
	json_owner=$(stat -c %u "${json_output}" 2>/dev/null) || json_owner=
	if [ ! -f "${json_output}" ] || [ -L "${json_output}" ] \
		|| [ "${json_owner}" != "${current_uid}" ]; then
		diagnostics_error "Refusing diagnostics JSON output that is not a regular, owned file."
		return 2
	fi
	if [ "${text_output}" != - ]; then
		text_owner=$(stat -c %u "${text_output}" 2>/dev/null) || text_owner=
		if [ ! -f "${text_output}" ] || [ -L "${text_output}" ] \
			|| [ "${text_owner}" != "${current_uid}" ]; then
			diagnostics_error "Refusing diagnostics text output that is not a regular, owned file."
			return 2
		fi
	fi
	ready_owner=$(stat -c %u "${ready_output}" 2>/dev/null) || ready_owner=
	if [ ! -f "${ready_output}" ] || [ -L "${ready_output}" ] \
		|| [ "${ready_owner}" != "${current_uid}" ]; then
		diagnostics_error "Refusing diagnostics readiness signal that is not a regular, owned file."
		return 2
	fi

	umask 077
	start_monotonic=$(diagnostics_monotonic_seconds)
	case "${start_monotonic}" in
		"" | *[!0-9]*)
			diagnostics_error "A monotonic clock is required for bounded captures."
			return 1
			;;
		*) ;;
	esac
	end_monotonic=$((start_monotonic + seconds))
	[ "${journal_cursor}" != - ] || journal_cursor=
	completed=false

	finalize_capture() {
		if [ "${completed}" != true ]; then
			# Best-effort finalization must not recurse through EXIT.
			# shellcheck disable=SC2310
			diagnostics_capture_event interrupted "Capture ended before its requested deadline." >>"${json_output}" || true
		fi
		rendered=false
		if [ "${format}" != json ] && [ "${text_output}" != - ]; then
			# Rendering failures are handled explicitly so the JSONL source is retained.
			# shellcheck disable=SC2310
			if diagnostics_render <"${json_output}" >"${text_output}"; then
				rendered=true
			else
				printf 'Text rendering failed. Structured diagnostics remain at: %s\n' \
					"${json_output}" >"${text_output}"
			fi
		fi
		if [ "${format}" = text ] && [ "${rendered}" = true ]; then
			rm -f "${json_output}"
		fi
	}
	trap 'finalize_capture' EXIT
	trap '' HUP
	trap 'exit 143' INT TERM

	: >"${json_output}"
	{
		diagnostics_privacy_header
		diagnostics_capture_event started "Capture started."
		diagnostics_section "Initial Snapshot"
		diagnostics_snapshot "${verbosity}" false
		diagnostics_section "Timeline"
	} >>"${json_output}"
	printf 'ready\n' >"${ready_output}"

	case "${verbosity}" in
		summary) interval=60 ;;
		normal) interval=15 ;;
		debug) interval=5 ;;
		*)
			diagnostics_error "Invalid worker verbosity ${verbosity}."
			return 2
			;;
	esac

	while :; do
		diagnostics_emit_sample >>"${json_output}"
		now_monotonic=$(diagnostics_monotonic_seconds)
		[ "${now_monotonic}" -lt "${end_monotonic}" ] || break
		remaining=$((end_monotonic - now_monotonic))
		wait_seconds=${interval}
		[ "${remaining}" -ge "${wait_seconds}" ] || wait_seconds=${remaining}
		sleep "${wait_seconds}"
	done

	{
		diagnostics_section "Final Snapshot"
		diagnostics_snapshot "${verbosity}" false
	} >>"${json_output}"
	if [ "${verbosity}" != summary ]; then
		if [ "${verbosity}" = debug ]; then
			log_lines=10000
		else
			log_lines=1000
		fi
		if [ -n "${journal_cursor}" ]; then
			captured_logs=$(diagnostics_command journalctl --after-cursor="${journal_cursor}" \
				-n "${log_lines}" -o cat -u udm-iptv-restore.service \
				-u udm-iptv.service --no-pager)
		else
			captured_logs="A journal cursor was unavailable when the capture started."
		fi
		diagnostics_refresh_device_addresses
		{
			diagnostics_section "Captured Service Logs"
			diagnostics_block "Captured Service Logs" "at most ${log_lines} unit messages" "${captured_logs}"
		} >>"${json_output}"
	fi
	diagnostics_capture_event completed "Capture reached its ${seconds}s deadline." >>"${json_output}"
	completed=true
	trap - EXIT INT TERM
	finalize_capture
}

diagnostics_start_capture() {
	seconds=$1
	verbosity=$2
	format=$3

	if ! command -v nohup >/dev/null 2>&1; then
		diagnostics_error "nohup is required to run a capture after the SSH session closes."
		return 1
	fi
	mkdir -p "${DIAGNOSTICS_DIR}"
	umask 077
	started_at=$(date -u '+%Y%m%dT%H%M%SZ')
	json_output=$(mktemp "${DIAGNOSTICS_DIR}/udm-iptv-diagnostics-${started_at}-XXXXXX.jsonl")
	ready_output=$(mktemp "${DIAGNOSTICS_DIR}/udm-iptv-diagnostics-${started_at}-XXXXXX.ready")
	if [ "${format}" = json ]; then
		text_output=-
	else
		text_output=$(mktemp "${DIAGNOSTICS_DIR}/udm-iptv-diagnostics-${started_at}-XXXXXX.txt")
	fi
	journal_cursor=-
	if [ "${verbosity}" != summary ]; then
		journal_cursor=$(
			LC_ALL=C journalctl -n 0 --show-cursor --no-pager 2>/dev/null \
				| sed -n 's/^-- cursor: //p'
		)
		[ -n "${journal_cursor}" ] || journal_cursor=-
	fi

	nohup "$0" --worker "${seconds}" "${verbosity}" "${format}" \
		"${json_output}" "${text_output}" "${journal_cursor}" "${ready_output}" </dev/null >/dev/null 2>&1 &
	worker_pid=$!
	if [ -n "${UDM_IPTV_TEST_STARTUP_DELAY:-}" ]; then
		sleep "${UDM_IPTV_TEST_STARTUP_DELAY}"
	fi
	attempt=0
	while [ "${attempt}" -lt 20 ]; do
		if [ -s "${ready_output}" ]; then
			break
		fi
		if ! kill -0 "${worker_pid}" 2>/dev/null; then
			wait "${worker_pid}" 2>/dev/null || true
			rm -f "${json_output}" "${ready_output}"
			[ "${text_output}" = - ] || rm -f "${text_output}"
			diagnostics_error "Diagnostics capture failed to start."
			return 1
		fi
		attempt=$((attempt + 1))
		sleep 0.1
	done
	if [ ! -s "${ready_output}" ]; then
		kill "${worker_pid}" 2>/dev/null || true
		wait "${worker_pid}" 2>/dev/null || true
		rm -f "${json_output}" "${ready_output}"
		[ "${text_output}" = - ] || rm -f "${text_output}"
		diagnostics_error "Diagnostics capture did not initialize in time."
		return 1
	fi
	rm -f "${ready_output}"

	echo "Diagnostics capture started in the background (PID ${worker_pid})."
	echo "It will stop automatically after ${seconds} seconds."
	case "${format}" in
		text)
			echo "Share-ready text: ${text_output}"
			echo "Read it after completion with: cat ${text_output}"
			;;
		json)
			echo "Structured JSON Lines: ${json_output}"
			;;
		both)
			echo "Share-ready text: ${text_output}"
			echo "Structured JSON Lines: ${json_output}"
			echo "Read the text after completion with: cat ${text_output}"
			;;
		*)
			diagnostics_error "Invalid capture format ${format}."
			return 2
			;;
	esac
	echo "The final file ends with 'Capture completed'. Review it before posting it publicly."
}

diagnostics_once() {
	verbosity=$1
	format=$2
	case "${format}" in
		text | json) DIAGNOSTICS_STREAM_FORMAT=${format} ;;
		*)
			diagnostics_error "Format 'both' is only valid with --capture."
			return 2
			;;
	esac
	diagnostics_privacy_header
	diagnostics_snapshot "${verbosity}" true
}

if [ "${1:-}" = --worker ]; then
	[ "$#" -eq 8 ] || {
		diagnostics_error "Invalid internal diagnostics worker invocation."
		exit 2
	}
	shift
	diagnostics_requirements
	diagnostics_load_configuration
	diagnostics_worker "$@"
	exit
fi

capture=
format=text
format_set=false
verbosity=normal
while [ "$#" -gt 0 ]; do
	case "$1" in
		--capture)
			[ "$#" -ge 2 ] || {
				diagnostics_error "--capture requires a duration."
				exit 2
			}
			# Invalid input is handled by this branch.
			# shellcheck disable=SC2310
			capture=$(diagnostics_parse_duration "$2") || {
				diagnostics_error "Duration must be between 1s and 24h and use s, m, or h."
				exit 2
			}
			shift 2
			;;
		--format)
			[ "$#" -ge 2 ] || {
				diagnostics_error "--format requires text, json, or both."
				exit 2
			}
			case "$2" in
				text | json | both) format=$2 ;;
				*)
					diagnostics_error "Format must be text, json, or both."
					exit 2
					;;
			esac
			format_set=true
			shift 2
			;;
		--verbosity)
			[ "$#" -ge 2 ] || {
				diagnostics_error "--verbosity requires summary, normal, or debug."
				exit 2
			}
			case "$2" in
				summary | normal | debug) verbosity=$2 ;;
				*)
					diagnostics_error "Verbosity must be summary, normal, or debug."
					exit 2
					;;
			esac
			shift 2
			;;
		-h | --help)
			diagnostics_usage
			exit 0
			;;
		*)
			diagnostics_error "Unknown diagnose option $1."
			diagnostics_usage >&2
			exit 2
			;;
	esac
done

diagnostics_requirements
diagnostics_load_configuration
if [ -n "${capture}" ]; then
	if [ "${format_set}" = false ]; then
		format=both
	fi
	diagnostics_start_capture "${capture}" "${verbosity}" "${format}"
else
	diagnostics_once "${verbosity}" "${format}"
fi
