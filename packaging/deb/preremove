#!/bin/sh
set -eu

# --from-package keeps this out of apt, which is holding the dpkg lock that
# called it. dpkg removes the files the package shipped.
if [ "${1:-}" = remove ] && [ -x /data/udm-iptv/bin/udm-iptv ]; then
	if [ "${UDM_IPTV_REMOVE_KEEP_DATA:-false}" = true ]; then
		/data/udm-iptv/bin/udm-iptv uninstall --keep-data --from-package
	else
		/data/udm-iptv/bin/udm-iptv uninstall --keep-config --from-package
	fi
fi
